<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon, in Android's three layers: the coral behind, the
     tickets and the coach in front (both rendered from tools/app-icons.html
     by tools/render-icons.sh), and the small mark Android 13 and later tint
     to the wallpaper when themed icons are on (drawn by make-pictures.js). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
